<UserControl
    x:Class="LocalTodo.Views.AchievementView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    ClipToBounds="True"
    Focusable="True"
    Loaded="OnViewLoaded"
    Unloaded="OnViewUnloaded"
    PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
    PreviewMouseMove="OnPreviewMouseMove"
    PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
    LostMouseCapture="OnLostMouseCapture"
    PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="AchievementInfoCardHostStyle" TargetType="Grid">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AchievementInfoCardSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7ECF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D9E1EC" />
                </Trigger>
                <DataTrigger Binding="{Binding IsRecentlyAdjusted}" Value="True">
                    <Setter Property="Background" Value="#FBFDFF" />
                    <Setter Property="BorderBrush" Value="#5B83EA" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInteractionActive}" Value="True">
                    <Setter Property="Background" Value="#F5F8FF" />
                    <Setter Property="BorderBrush" Value="#2F6FED" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 成长记录时间轴专用：12px 命中高度、6px 可见滑块。 -->
        <ControlTemplate
            x:Key="AchievementTimelineHorizontalScrollBarTemplate"
            TargetType="{x:Type ScrollBar}">
            <Grid
                Height="12"
                Background="Transparent"
                SnapsToDevicePixels="True">
                <Track
                    x:Name="PART_Track"
                    Minimum="{TemplateBinding Minimum}"
                    Maximum="{TemplateBinding Maximum}"
                    Value="{TemplateBinding Value}"
                    ViewportSize="{TemplateBinding ViewportSize}"
                    Orientation="Horizontal"
                    IsDirectionReversed="False"
                    Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsTabStop="False"
                            Command="{x:Static ScrollBar.PageLeftCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb
                            MinWidth="40"
                            Margin="1,0"
                            Background="#B8C1CF">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Grid Background="Transparent">
                                        <Border
                                            x:Name="ThumbBody"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBody" Property="Background" Value="#929EAF" />
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBody" Property="Background" Value="#6F7D92" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsTabStop="False"
                            Command="{x:Static ScrollBar.PageRightCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- 竖向滚动条保留 10px 命中宽度，只显示约 4px 的细滑块。 -->
        <ControlTemplate
            x:Key="AchievementTimelineVerticalScrollBarTemplate"
            TargetType="{x:Type ScrollBar}">
            <Grid
                Width="10"
                Background="Transparent"
                SnapsToDevicePixels="True">
                <Track
                    x:Name="PART_Track"
                    Minimum="{TemplateBinding Minimum}"
                    Maximum="{TemplateBinding Maximum}"
                    Value="{TemplateBinding Value}"
                    ViewportSize="{TemplateBinding ViewportSize}"
                    Orientation="Vertical"
                    IsDirectionReversed="True"
                    Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsTabStop="False"
                            Command="{x:Static ScrollBar.PageUpCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb
                            MinHeight="40"
                            Margin="3,1"
                            Background="#B8C1CF">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border
                                        x:Name="ThumbBody"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="2" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBody" Property="Background" Value="#929EAF" />
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBody" Property="Background" Value="#6F7D92" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsTabStop="False"
                            Command="{x:Static ScrollBar.PageDownCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DrawerLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="DrawerCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Content" Value="×" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="CategoryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border
                                x:Name="Surface"
                                Padding="10,9"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                                <ContentPresenter />
                            </Border>
                            <Border
                                x:Name="DropBefore"
                                Height="2"
                                Margin="4,-3,4,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource Brush.Primary}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="DropAfter"
                                Height="2"
                                Margin="4,0,4,-3"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource Brush.Primary}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.SurfaceSelected}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="DropBefore">
                                <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Tag" Value="DropAfter">
                                <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Height="36"
                Background="{StaticResource Brush.CardBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Width="38"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding PreviousYearCommand}"
                        Click="OnYearNavigationClick"
                        Content="‹"
                        FontSize="20"
                        Foreground="{StaticResource Brush.TextSecondary}" />
                    <Border Width="82" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding SelectedYearText}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Brush.TextPrimary}" />
                    </Border>
                    <Button
                        Width="38"
                        Height="34"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding NextYearCommand}"
                        Click="OnYearNavigationClick"
                        Content="›"
                        FontSize="20"
                        Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Border>

            <ComboBox
                Grid.Column="2"
                Width="150"
                Height="36"
                ItemsSource="{Binding FilterOptions}"
                DisplayMemberPath="Title"
                SelectedItem="{Binding SelectedFilter}"
                FontSize="13" />

            <Button
                Grid.Column="4"
                MinWidth="86"
                Height="36"
                Padding="12,0"
                Command="{Binding OpenCategoryManagerCommand}"
                Content="管理分类"
                FontSize="12" />

            <Button
                Grid.Column="6"
                MinWidth="116"
                Height="36"
                Padding="14,0"
                VerticalAlignment="Center"
                Style="{StaticResource TaskPrimaryActionButtonStyle}"
                Command="{Binding StartCreateCommand}"
                Content="＋ 记录新成果"
                FontSize="12" />
        </Grid>

        <Grid Grid.Row="1" Margin="4,0,4,10">
            <TextBlock
                Text="{Binding YearSummaryText}"
                FontSize="14"
                Foreground="{StaticResource Brush.TextSecondary}" />
            <TextBlock
                HorizontalAlignment="Right"
                Text="左右滑动查看相邻年度 · 拖动时间条移动 · 拖动两端调整日期"
                FontSize="12"
                Foreground="{StaticResource Brush.TextMuted}" />
        </Grid>

        <!-- 连续三年时间轴：月份表头与内容同步横向滑动。 -->
        <Border
            Grid.Row="2"
            Background="{StaticResource Brush.CardBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
            <Grid
                x:Name="TimelineViewport"
                SizeChanged="OnTimelineViewportSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Background="#FBFCFE"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                    <ScrollViewer
                        x:Name="TimelineHeaderScrollViewer"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        IsHitTestVisible="False"
                        Focusable="False">
                        <ItemsControl
                            Width="{Binding TimelineWidth}"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Months}"
                            IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="47">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#EDF1F6" />
                                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsYearStart}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                                                        <Setter Property="BorderThickness" Value="1,0,1,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding Title}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#596579" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <ScrollViewer
                    x:Name="TimelineScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ScrollChanged="OnTimelineScrollChanged">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Height" Value="12" />
                                    <Setter Property="MinHeight" Value="12" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Opacity" Value="0.72" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter
                                        Property="Template"
                                        Value="{StaticResource AchievementTimelineHorizontalScrollBarTemplate}" />
                                </Trigger>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="10" />
                                    <Setter Property="MinWidth" Value="10" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Opacity" Value="0.72" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter
                                        Property="Template"
                                        Value="{StaticResource AchievementTimelineVerticalScrollBarTemplate}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Orientation" Value="Horizontal" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0.96" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Orientation" Value="Vertical" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0.96" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Orientation" Value="Horizontal" />
                                        <Condition Property="IsEnabled" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0.18" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Orientation" Value="Vertical" />
                                        <Condition Property="IsEnabled" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0.18" />
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <Grid
                        x:Name="TimelineSurface"
                        Width="{Binding TimelineWidth}"
                        Height="{Binding TimelineContentHeight}"
                        HorizontalAlignment="Left"
                        ClipToBounds="True">

                        <ItemsControl
                            Width="{Binding TimelineWidth}"
                            Height="{Binding TimelineContentHeight}"
                            ItemsSource="{Binding Months}"
                            IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="{Binding Width}"
                                        Height="{Binding DataContext.TimelineContentHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#EDF1F6" />
                                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsYearStart}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                                                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl
                            Width="{Binding TimelineWidth}"
                            Height="{Binding TimelineContentHeight}"
                            ItemsSource="{Binding TimelineItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="0" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Canvas
                                        Width="{Binding CanvasWidth}"
                                        Height="{Binding Height}"
                                        Background="Transparent">

                                        <!-- 信息卡片只负责可读信息，宽度与持续时间完全解耦。 -->
                                        <Grid
                                            Canvas.Left="{Binding CardLeft}"
                                            Canvas.Top="0"
                                            Width="{Binding CardWidth}"
                                        Height="63"
                                        Cursor="SizeAll"
                                        Style="{StaticResource AchievementInfoCardHostStyle}"
                                        MouseLeftButtonDown="OnAchievementCardMouseLeftButtonDown">

                                            <!-- 阴影与文字分层，避免 Effect 导致文字栅格化模糊。 -->
                                            <Border
                                                Height="56"
                                                Margin="3,2,3,0"
                                                VerticalAlignment="Top"
                                                Background="#FFFFFF"
                                                CornerRadius="9"
                                                IsHitTestVisible="False">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="14"
                                                        Direction="270"
                                                        Opacity="0.11"
                                                        ShadowDepth="3"
                                                        Color="#233451" />
                                                </Border.Effect>
                                            </Border>

                                            <Border
                                                Height="56"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource AchievementInfoCardSurfaceStyle}">
                                                <Grid>
                                                    <Border
                                                        Width="4"
                                                        Margin="3,7,0,7"
                                                        HorizontalAlignment="Left"
                                                        Background="#2F6FED"
                                                        CornerRadius="2"
                                                        Panel.ZIndex="2"
                                                        IsHitTestVisible="False">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecentlyAdjusted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInteractionActive}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Grid Margin="14,6,12,5">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <TextBlock
                                                            MaxWidth="160"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Title}"
                                                            FontSize="15"
                                                            FontWeight="SemiBold"
                                                            Foreground="#1F2A3D"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Margin="8,0,0,0"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding CategorySoftColor}"
                                                            CornerRadius="8">
                                                            <TextBlock
                                                                MaxWidth="72"
                                                                Text="{Binding CategoryText}"
                                                                FontSize="11"
                                                                Foreground="{Binding CategoryColor}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,1,0,0"
                                                        VerticalAlignment="Top"
                                                        Text="{Binding TimelineDateText}"
                                                        FontSize="13"
                                                        Foreground="#69768C"
                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Canvas IsHitTestVisible="False">
                                                <Polygon
                                                    Canvas.Left="{Binding PointerOffset}"
                                                    Canvas.Top="54"
                                                    Points="0,0 12,0 6,7"
                                                    Fill="#FFFFFF"
                                                    Stroke="#E7ECF3"
                                                    StrokeThickness="1" />
                                            </Canvas>
                                        </Grid>

                                        <!-- 中间线严格等于日期坐标差，不设置任何最小宽度。 -->
                                        <Border
                                            Canvas.Left="{Binding Left}"
                                            Canvas.Top="{Binding TrackTop}"
                                            Width="{Binding Width}"
                                            Background="{Binding CategoryColor}"
                                            CornerRadius="1.5"
                                            SnapsToDevicePixels="True"
                                            Cursor="SizeAll"
                                            MouseLeftButtonDown="OnAchievementCardMouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="3" />
                                                    <Setter Property="Opacity" Value="0.90" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="Height" Value="4" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSingleDay}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecentlyAdjusted}" Value="True">
                                                            <Setter Property="Height" Value="4" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInteractionActive}" Value="True">
                                                            <Setter Property="Height" Value="5" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- 透明移动命中区可以更高，但绝不改变真实线段宽度。 -->
                                        <Border
                                            Canvas.Left="{Binding MoveHitLeft}"
                                            Canvas.Top="{Binding StartHandleTop}"
                                            Width="{Binding MoveHitWidth}"
                                            Height="22"
                                            Background="Transparent"
                                            Cursor="SizeAll"
                                            Panel.ZIndex="3"
                                            MouseLeftButtonDown="OnAchievementCardMouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleDay}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- 独立大命中区：圆点跟随各自命中区，避免透明层遮挡悬停反馈。 -->
                                        <Canvas
                                            Canvas.Left="{Binding StartHandleLeft}"
                                            Canvas.Top="{Binding StartHandleTop}"
                                            Width="14"
                                            Height="{Binding HandleHeight}"
                                            Background="Transparent"
                                            Cursor="SizeWE"
                                            Panel.ZIndex="6"
                                            MouseLeftButtonDown="OnAchievementStartHandleMouseLeftButtonDown">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleDay}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>
                                            <Ellipse
                                                Canvas.Left="{Binding StartNodeOffset}"
                                                Canvas.Top="{Binding StartNodeTopOffset}"
                                                Width="10"
                                                Height="10"
                                                Fill="{Binding CategoryColor}"
                                                Stroke="#FFFFFF"
                                                StrokeThickness="1.5"
                                                IsHitTestVisible="False">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Canvas}}" Value="True">
                                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value><ScaleTransform ScaleX="1.18" ScaleY="1.18" /></Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Canvas>
                                        <Canvas
                                            Canvas.Left="{Binding EndHandleLeft}"
                                            Canvas.Top="{Binding EndHandleTop}"
                                            Width="14"
                                            Height="{Binding HandleHeight}"
                                            Background="Transparent"
                                            Cursor="SizeWE"
                                            Panel.ZIndex="6"
                                            MouseLeftButtonDown="OnAchievementEndHandleMouseLeftButtonDown">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleDay}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>
                                            <Ellipse
                                                Canvas.Left="{Binding EndNodeOffset}"
                                                Canvas.Top="{Binding EndNodeTopOffset}"
                                                Width="10"
                                                Height="10"
                                                Fill="{Binding CategoryColor}"
                                                Stroke="#FFFFFF"
                                                StrokeThickness="1.5"
                                                IsHitTestVisible="False">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Canvas}}" Value="True">
                                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value><ScaleTransform ScaleX="1.18" ScaleY="1.18" /></Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Canvas>

                                        <!-- 同日成果显示为单一菱形节点，不绘制重叠端点。 -->
                                        <Polygon
                                            Canvas.Left="{Binding SingleNodeLeft}"
                                            Canvas.Top="{Binding SingleNodeTop}"
                                            Points="6,0 12,6 6,12 0,6"
                                            Fill="{Binding CategoryColor}"
                                            Stroke="#FFFFFF"
                                            StrokeThickness="1.5"
                                            Cursor="SizeAll"
                                            Panel.ZIndex="7"
                                            MouseLeftButtonDown="OnAchievementCardMouseLeftButtonDown">
                                            <Polygon.Style>
                                                <Style TargetType="Polygon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleDay}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.12" /></Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Polygon.Style>
                                        </Polygon>

                                        <!-- 单日节点左右各保留一块窄命中区，可从菱形直接扩展起止日期。 -->
                                        <Canvas
                                            Canvas.Left="{Binding SingleStartHandleLeft}"
                                            Canvas.Top="{Binding StartHandleTop}"
                                            Width="10"
                                            Height="22"
                                            Background="Transparent"
                                            Cursor="SizeWE"
                                            Panel.ZIndex="8"
                                            MouseLeftButtonDown="OnAchievementStartHandleMouseLeftButtonDown">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleDay}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>
                                        </Canvas>
                                        <Canvas
                                            Canvas.Left="{Binding SingleEndHandleLeft}"
                                            Canvas.Top="{Binding StartHandleTop}"
                                            Width="10"
                                            Height="22"
                                            Background="Transparent"
                                            Cursor="SizeWE"
                                            Panel.ZIndex="8"
                                            MouseLeftButtonDown="OnAchievementEndHandleMouseLeftButtonDown">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingleDay}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>
                                        </Canvas>
                                    </Canvas>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="3">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimelineEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="当前三年窗口还没有成长成果"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock
                                Margin="0,7,0,0"
                                Text="记录一件已经完成、值得被记住的事情。"
                                FontSize="12"
                                Foreground="{StaticResource Brush.TextMuted}" />
                            <Button
                                Margin="0,16,0,0"
                                MinWidth="112"
                                Height="36"
                                Style="{StaticResource TaskPrimaryActionButtonStyle}"
                                Command="{Binding StartCreateCommand}"
                                Content="记录新成果" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Panel.ZIndex="5"
            Text="{Binding StatusMessage}"
            FontSize="13"
            Foreground="{StaticResource Brush.Danger}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 详情和编辑合并：点击成果后，抽屉内所有字段可直接修改。 -->
        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="30"
            IsVisibleChanged="OnEditorVisibilityChanged">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border
                Background="Transparent"
                MouseLeftButtonDown="OnDrawerBackdropMouseLeftButtonDown" />

            <!-- 阴影只画在空白窄条上，不再栅格化抽屉里的文字。 -->
            <Border
                Width="1"
                Margin="0,0,460,0"
                HorizontalAlignment="Right"
                Background="{StaticResource Brush.BorderStrong}"
                IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        Direction="180"
                        Opacity="0.16"
                        ShadowDepth="0"
                        Color="#1E293B" />
                </Border.Effect>
            </Border>

            <Border
                Width="460"
                HorizontalAlignment="Right"
                Background="{StaticResource Brush.CardBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1,0,0,0"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="26,20,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Text="{Binding EditorHeading}"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Text="{Binding EditorHint}"
                                FontSize="12"
                                Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource DrawerCloseButtonStyle}"
                            Command="{Binding CloseEditorCommand}" />
                    </Grid>

                    <!-- 固定信息使用 Auto，高度剩余部分全部交给成果描述。 -->
                    <Grid Grid.Row="1" Margin="26,6,26,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="成果名称 *"
                            Style="{StaticResource DrawerLabelStyle}" />
                        <TextBox
                            x:Name="EditorTitleTextBox"
                            Grid.Row="1"
                            Height="40"
                            Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"
                            MaxLength="200"
                            FontSize="14" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,20,0,7"
                            Text="成果分类"
                            Style="{StaticResource DrawerLabelStyle}" />
                        <ComboBox
                            Grid.Row="3"
                            Height="40"
                            ItemsSource="{Binding Categories}"
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding EditorCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="13" />

                        <Grid Grid.Row="4" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始时间 *" Style="{StaticResource DrawerLabelStyle}" />
                                <DatePicker Height="40" SelectedDate="{Binding EditorStartedOn}" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="完成时间 *" Style="{StaticResource DrawerLabelStyle}" />
                                <DatePicker Height="40" SelectedDate="{Binding EditorCompletedOn}" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Grid.Row="5"
                            Margin="0,20,0,7"
                            Text="成果描述"
                            Style="{StaticResource DrawerLabelStyle}" />
                        <TextBox
                            Grid.Row="6"
                            MinHeight="96"
                            VerticalAlignment="Stretch"
                            Text="{Binding EditorDetails, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            MaxLength="4000"
                            FontSize="13" />

                        <Border
                            Grid.Row="7"
                            Margin="0,16,0,0"
                            Padding="12,10"
                            Background="#FFF7F7"
                            BorderBrush="{StaticResource Brush.DangerBorder}"
                            BorderThickness="1"
                            CornerRadius="7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEditorError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Text="{Binding EditorErrorMessage}"
                                FontSize="12"
                                Foreground="{StaticResource Brush.Danger}"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="26,14,26,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Height="40"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding SelectedRecord}"
                            Content="删除成果">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TaskDangerActionButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingExisting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Height="40"
                            Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TaskPrimaryActionButtonStyle}">
                                    <Setter Property="Content" Value="保存成果" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingExisting}" Value="True">
                                            <Setter Property="Content" Value="完成" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 分类管理采用独立抽屉：名称、预设色和十六进制颜色都可维护。 -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="40">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCategoryManagerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="Transparent" MouseLeftButtonDown="OnCategoryBackdropMouseLeftButtonDown" />
            <Border
                Width="1"
                Margin="0,0,620,0"
                HorizontalAlignment="Right"
                Background="{StaticResource Brush.BorderStrong}"
                IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Direction="180" Opacity="0.16" ShadowDepth="0" Color="#1E293B" />
                </Border.Effect>
            </Border>

            <Border
                Width="620"
                HorizontalAlignment="Right"
                Background="{StaticResource Brush.CardBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1,0,0,0"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="26,20,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="分类管理" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Margin="0,5,0,0" Text="创建自己的分类，并为时间轴设置识别颜色" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DrawerCloseButtonStyle}" Command="{Binding CloseCategoryManagerCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="24,4,24,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button
                                Height="36"
                                Margin="0,0,0,12"
                                Command="{Binding StartCreateCategoryCommand}"
                                Content="＋ 新建分类" />
                            <ListBox
                                x:Name="CategoryListBox"
                                Grid.Row="1"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedManagedCategory}"
                                ItemContainerStyle="{StaticResource CategoryListItemStyle}"
                                AllowDrop="True"
                                Background="Transparent"
                                BorderThickness="0"
                                PreviewMouseLeftButtonDown="OnCategoryListPreviewMouseLeftButtonDown"
                                PreviewMouseMove="OnCategoryListPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnCategoryListPreviewMouseLeftButtonUp"
                                DragOver="OnCategoryListDragOver"
                                DragLeave="OnCategoryListDragLeave"
                                Drop="OnCategoryListDrop"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Cursor="SizeNS">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding ColorHex}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="9,0,0,0"
                                                Text="{Binding Name}"
                                                FontSize="13"
                                                Foreground="{StaticResource Brush.TextPrimary}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="8,-1,0,0"
                                                VerticalAlignment="Center"
                                                Text="≡"
                                                FontSize="15"
                                                Foreground="{StaticResource Brush.TextMuted}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="1" Background="{StaticResource Brush.Border}" />

                        <StackPanel Grid.Column="2" Margin="22,4,0,0">
                            <TextBlock Text="分类名称" Style="{StaticResource DrawerLabelStyle}" />
                            <TextBox
                                Height="40"
                                Text="{Binding CategoryDraftName, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="30"
                                FontSize="13" />

                            <TextBlock Margin="0,22,0,7" Text="分类颜色" Style="{StaticResource DrawerLabelStyle}" />
                            <ItemsControl ItemsSource="{Binding CategoryColorOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,8,8"
                                            Padding="0"
                                            Background="{Binding ColorHex}"
                                            BorderBrush="{Binding ColorHex}"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.SelectCategoryColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,12,0,7" Text="自定义颜色值" Style="{StaticResource DrawerLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="40"
                                    Height="40"
                                    Background="{Binding CategoryDraftColor}"
                                    BorderBrush="{StaticResource Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="7" />
                                <TextBox
                                    Grid.Column="2"
                                    Height="40"
                                    Text="{Binding CategoryDraftColor, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="7"
                                    FontSize="13" />
                            </Grid>
                            <TextBlock
                                Margin="0,7,0,0"
                                Text="请输入 #RRGGBB，例如 #625BF6"
                                FontSize="11"
                                Foreground="{StaticResource Brush.TextMuted}" />

                            <Border
                                Margin="0,18,0,0"
                                Padding="12,10"
                                Background="#FFF7F7"
                                BorderBrush="{StaticResource Brush.DangerBorder}"
                                BorderThickness="1"
                                CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCategoryManagerError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CategoryManagerError}" FontSize="12" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="24,14,24,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Button
                            MinWidth="90"
                            Height="40"
                            Style="{StaticResource TaskDangerActionButtonStyle}"
                            IsEnabled="{Binding CanDeleteManagedCategory}"
                            Command="{Binding DeleteCategoryCommand}"
                            Content="删除分类" />
                        <Button
                            Grid.Column="2"
                            Height="40"
                            Style="{StaticResource TaskPrimaryActionButtonStyle}"
                            Command="{Binding SaveCategoryCommand}"
                            Content="保存分类" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
