<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:LocalTodo.Helpers">

    <Style TargetType="Window">
        <Setter
            Property="FontFamily"
            Value="Microsoft YaHei UI" />

        <Setter
            Property="TextElement.FontSize"
            Value="14" />

        <Setter
            Property="TextElement.Foreground"
            Value="{StaticResource Brush.TextPrimary}" />

    </Style>

    <!-- 使用 WPF 默认的 Ideal + ClearType 渲染，适配不同 DPI。 -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <!-- 现代轻量按钮：颜色仍可由各业务按钮覆盖，模板只统一形状和反馈。 -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="ButtonSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">

                        <ContentPresenter
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter
                                TargetName="ButtonSurface"
                                Property="BorderThickness"
                                Value="2" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!--
        任务操作按钮按参考图使用直角矩形。
        只覆盖外形与交互反馈，尺寸仍由各业务界面决定。
    -->
    <Style
        x:Key="TaskActionButtonBaseStyle"
        TargetType="{x:Type Button}"
        BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="ButtonSurface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0"
                        SnapsToDevicePixels="True">

                        <TextBlock
                            Text="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.96" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 添加任务：参考图中的明亮蓝底和白色文字。 -->
    <Style
        x:Key="TaskPrimaryActionButtonStyle"
        TargetType="{x:Type Button}"
        BasedOn="{StaticResource TaskActionButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.TaskActionPrimary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TaskActionPrimaryForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.TaskActionPrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.TaskActionPrimaryHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.TaskActionPrimaryHover}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.TaskActionPrimaryPressed}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.TaskActionPrimaryPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 删除任务：白底、清晰红字和浅红细边框。 -->
    <Style
        x:Key="TaskDangerActionButtonStyle"
        TargetType="{x:Type Button}"
        BasedOn="{StaticResource TaskActionButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.TaskActionDanger}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TaskActionDangerForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.TaskActionDangerBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.TaskActionDangerHover}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.TaskActionDangerPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 输入控件统一使用柔和背景、细边框和清晰焦点色。 -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.PrimaryLight}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="InputSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">

                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Padding="{TemplateBinding Padding}"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter
                                TargetName="InputSurface"
                                Property="BorderBrush"
                                Value="{StaticResource Brush.Primary}" />
                        </Trigger>

                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter
                                TargetName="InputSurface"
                                Property="Background"
                                Value="{StaticResource Brush.SurfacePressed}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter
                                TargetName="InputSurface"
                                Property="BorderBrush"
                                Value="{StaticResource Brush.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 多行任务说明从内容区顶部开始排版。 -->
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 新增/编辑任务窗口恢复原版白色输入区域与轻边框。 -->
    <Style
        x:Key="TaskEditorTextBoxStyle"
        TargetType="{x:Type TextBox}"
        BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource Brush.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.EditorBorder}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- 任务编辑器建立 17 / 14 / 13 的清晰字号层级。 -->
    <Style
        x:Key="TaskPopupHeadingTextStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style
        x:Key="TaskDetailsHeadingTextStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style
        x:Key="TaskDetailsTextBoxStyle"
        TargetType="{x:Type TextBox}"
        BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 日期文字只负责显示。PART_Button 覆盖日期区域，保留原生日历的选择/关闭行为。 -->
    <Style x:Key="DatePickerDisplayTextStyle" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AllowDrop" Value="False" />
        <Setter Property="ContextMenu" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="helpers:DatePickerInteraction.IsEnabled" Value="True" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Grid x:Name="PART_Root" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border x:Name="DateSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PART_Button"
                                    Padding="0" BorderThickness="0" Background="Transparent"
                                    Foreground="{StaticResource Brush.TextSecondary}"
                                    Focusable="True" IsTabStop="True"
                                    AutomationProperties.Name="选择日期"
                                    AutomationProperties.HelpText="点击日期区域打开日历，也可按空格或 Enter。">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 显式样式避免各页面的 DatePickerTextBox 样式恢复可编辑状态。 -->
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Margin="8,0,2,0"
                                               Style="{StaticResource DatePickerDisplayTextStyle}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}" />
                            <TextBlock x:Name="DatePlaceholder"
                                       Text="选择日期" Margin="8,0,30,0"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <Path x:Name="CalendarGlyph"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Margin="0,0,9,0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" IsHitTestVisible="False"
                                  Stroke="{StaticResource Brush.TextSecondary}" StrokeThickness="1.3"
                                  Data="M 3,4 L 17,4 L 17,18 L 3,18 Z M 3,8 L 17,8 M 7,2 L 7,6 M 13,2 L 13,6 M 6,11 L 8,11 M 11,11 L 13,11 M 6,14 L 8,14 M 11,14 L 13,14"
                                  Visibility="Collapsed" />

                            <!-- 有日期时以独立清除入口替代原先的删空文字；不占用日期的点击区。 -->
                            <Button x:Name="ClearDateButton" Grid.Column="1"
                                    Width="26" Padding="0" BorderThickness="0"
                                    Background="Transparent" Foreground="{StaticResource Brush.TextSecondary}"
                                    Command="{x:Static helpers:DatePickerInteraction.ClearDateCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    AutomationProperties.Name="清除日期"
                                    ToolTip="清除日期">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="ClearSurface" Background="Transparent" CornerRadius="0,6,6,0">
                                            <Path Width="9" Height="9" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                                  Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClearSurface" Property="Background" Value="{StaticResource Brush.PrimaryLight}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ClearSurface" Property="Background" Value="{StaticResource Brush.PrimaryLight}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- DatePicker.OnApplyTemplate 会填充其原生 Calendar，不重建日期规则。 -->
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               StaysOpen="False" AllowsTransparency="True" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedDate" Value="{x:Null}">
                            <Setter TargetName="ClearDateButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TextBox" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="DatePlaceholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CalendarGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DateSurface" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            <Setter TargetName="DateSurface" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DateSurface" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="DateSurface" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            <Setter TargetName="DateSurface" Property="Background" Value="{StaticResource Brush.PrimaryLight}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="DateSurface" Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.48" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 任务完成与重点标记使用紧凑的现代复选框。 -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="CheckSurface"
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.CardBackground}"
                            BorderBrush="{StaticResource Brush.BorderStrong}"
                            BorderThickness="1.2"
                            CornerRadius="5">

                            <TextBlock
                                x:Name="CheckGlyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="✓"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                Visibility="Collapsed" />
                        </Border>

                        <ContentPresenter
                            Grid.Column="1"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="CheckSurface"
                                Property="BorderBrush"
                                Value="{StaticResource Brush.Primary}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter
                                TargetName="CheckSurface"
                                Property="Background"
                                Value="{StaticResource Brush.Primary}" />
                            <Setter
                                TargetName="CheckSurface"
                                Property="BorderBrush"
                                Value="{StaticResource Brush.Primary}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        “标记为重要/重点任务”使用独立的轻量样式。
        未选中时只是一个细边框；选中时显示橙色星标，
        不再使用大面积蓝色填充。
    -->
    <Style
        x:Key="ImportantTaskCheckBoxStyle"
        TargetType="{x:Type CheckBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="ImportantSurface"
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.CardBackground}"
                            BorderBrush="{StaticResource Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <TextBlock
                                x:Name="ImportantGlyph"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="★"
                                FontSize="11"
                                Foreground="{StaticResource Brush.Warning}"
                                Visibility="Collapsed" />
                        </Border>

                        <ContentPresenter
                            Grid.Column="1"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="ImportantSurface"
                                Property="BorderBrush"
                                Value="{StaticResource Brush.Warning}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter
                                TargetName="ImportantSurface"
                                Property="Background"
                                Value="#FFF8E8" />
                            <Setter
                                TargetName="ImportantSurface"
                                Property="BorderBrush"
                                Value="{StaticResource Brush.Warning}" />
                            <Setter
                                TargetName="ImportantGlyph"
                                Property="Visibility"
                                Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.58" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Background" Value="#F02B3445" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="PopupCardStyle"
        TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource Brush.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.EditorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="TextElement.FontSize" Value="14" />
    </Style>

    <!-- =============================================== -->
    <!-- 任务列表状态图标                               -->
    <!--                                                 -->
    <!-- 普通任务：       不显示图标                    -->
    <!-- 重点任务：       橙色五角星                    -->
    <!-- 循环任务：       橙色空心圆                    -->
    <!-- 重点 + 循环：    橙色圆圈包住五角星            -->
    <!--                                                 -->
    <!-- 使用方式：                                       -->
    <!--                                                 -->
    <!-- 如果当前 DataContext 本身就是 TaskItem：        -->
    <!-- <ContentPresenter                               -->
    <!--     Content="{Binding}"                         -->
    <!--     ContentTemplate="{StaticResource            -->
    <!--         TaskListStatusMarkerTemplate}" />       -->
    <!--                                                 -->
    <!-- 如果当前 DataContext 是 TaskListEntry：         -->
    <!-- <ContentPresenter                               -->
    <!--     Content="{Binding Task}"                    -->
    <!--     ContentTemplate="{StaticResource            -->
    <!--         TaskListStatusMarkerTemplate}" />       -->
    <!-- =============================================== -->

    <DataTemplate
        x:Key="TaskListStatusMarkerTemplate">

        <!--
            统一的 18 × 18 图标槽位。

            普通任务时整个区域 Collapsed，
            不会在任务标题前留下空白。

            只要 IsImportant 或 IsRecurring
            任意一个为 True，就显示该区域。
        -->
        <Grid
            Width="18"
            Height="18"
            Margin="0,0,4,0"
            VerticalAlignment="Center"
            SnapsToDevicePixels="True"
            IsHitTestVisible="False">

            <Grid.Style>
                <Style
                    TargetType="{x:Type Grid}">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                    <Style.Triggers>

                        <!-- 重点任务：显示图标槽位 -->
                        <DataTrigger
                            Binding="{Binding IsImportant}"
                            Value="True">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />
                        </DataTrigger>

                        <!-- 循环任务：显示图标槽位 -->
                        <DataTrigger
                            Binding="{Binding IsRecurring}"
                            Value="True">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </Grid.Style>


            <!-- ===================================== -->
            <!-- 循环任务外圈                          -->
            <!-- ===================================== -->
            <Ellipse
                Width="14"
                Height="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stroke="#D97706"
                StrokeThickness="1.0"
                SnapsToDevicePixels="True">

                <Ellipse.Style>
                    <Style
                        TargetType="{x:Type Ellipse}">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding IsRecurring}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>


            <!-- ===================================== -->
            <!-- 重点任务五角星                        -->
            <!-- ===================================== -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="★"
                Foreground="#D97706"
                TextAlignment="Center"
                SnapsToDevicePixels="True">

                <TextBlock.Style>
                    <Style
                        TargetType="{x:Type TextBlock}">

                        <!--
                            普通重点任务：
                            保持与原任务列表接近的 14px 五角星。
                        -->
                        <Setter
                            Property="FontSize"
                            Value="14" />

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <!--
                            微调文字基线，
                            让五角星视觉上更居中。
                        -->
                        <Setter
                            Property="Margin"
                            Value="0,-1,0,0" />

                        <Style.Triggers>

                            <!-- 只有重点任务才显示五角星 -->
                            <DataTrigger
                                Binding="{Binding IsImportant}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />
                            </DataTrigger>

                            <!--
                                循环任务有外圈。
                                如果同时又是重点任务，
                                星需要缩小，避免贴住圆圈。
                            -->
                            <DataTrigger
                                Binding="{Binding IsRecurring}"
                                Value="True">

                                <Setter
                                    Property="FontSize"
                                    Value="10.5" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>

    </DataTemplate>

<!-- =============================================== -->
<!-- 日历任务状态图标：紧凑版本                      -->
<!--                                                 -->
<!-- 普通任务：       无图标                         -->
<!-- 重点任务：       ★                              -->
<!-- 循环任务：       ○                              -->
<!-- 重点循环任务：   圆圈包住 ★                     -->
<!--                                                 -->
<!-- 与普通任务列表使用相同业务规则，                -->
<!-- 只是尺寸更小，避免撑高日历日期格任务行。        -->
<!-- =============================================== -->
<DataTemplate
    x:Key="CalendarTaskStatusMarkerTemplate">

    <Grid
        Width="14"
        Height="14"
        Margin="0,0,3,0"
        VerticalAlignment="Center"
        SnapsToDevicePixels="True"
        IsHitTestVisible="False">

        <!--
            普通任务：
            整个图标区域隐藏。

            重点或循环任务：
            显示该图标区域。
        -->
        <Grid.Style>

            <Style
                TargetType="{x:Type Grid}">

                <Setter
                    Property="Visibility"
                    Value="Collapsed" />

                <Style.Triggers>

                    <DataTrigger
                        Binding="{Binding IsImportant}"
                        Value="True">

                        <Setter
                            Property="Visibility"
                            Value="Visible" />

                    </DataTrigger>

                    <DataTrigger
                        Binding="{Binding IsRecurring}"
                        Value="True">

                        <Setter
                            Property="Visibility"
                            Value="Visible" />

                    </DataTrigger>

                </Style.Triggers>

            </Style>

        </Grid.Style>


        <!-- ===================================== -->
        <!-- 循环任务圆圈                          -->
        <!-- ===================================== -->
        <Ellipse
            Width="12"
            Height="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Stroke="#D97706"
            StrokeThickness="1"
            SnapsToDevicePixels="True">

            <Ellipse.Style>

                <Style
                    TargetType="{x:Type Ellipse}">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding IsRecurring}"
                            Value="True">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Ellipse.Style>

        </Ellipse>


        <!-- ===================================== -->
        <!-- 重点任务五角星                        -->
        <!-- ===================================== -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="★"
            Foreground="#D97706"
            TextAlignment="Center"
            SnapsToDevicePixels="True">

            <TextBlock.Style>

                <Style
                    TargetType="{x:Type TextBlock}">

                    <!--
                        日历原来的重点星就是 11，
                        因此普通重点任务保持这个尺寸。
                    -->
                    <Setter
                        Property="FontSize"
                        Value="11" />

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                    <!--
                        轻微调整基线，
                        让五角星视觉上位于圆心。
                    -->
                    <Setter
                        Property="Margin"
                        Value="0,0,0,0" />

                    <Style.Triggers>

                        <!-- 重点任务显示五角星 -->
                        <DataTrigger
                            Binding="{Binding IsImportant}"
                            Value="True">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                        </DataTrigger>

                        <!--
                            如果还是循环任务，
                            星缩小以后放在圆圈内部。
                        -->
                        <DataTrigger
                            Binding="{Binding IsRecurring}"
                            Value="True">

                            <Setter
                                Property="FontSize"
                                Value="8" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </TextBlock.Style>

        </TextBlock>

    </Grid>

</DataTemplate>



    <!-- =============================================== -->
<!-- 任务说明 TextBox 专用细竖向滚动条             -->
<!--                                                 -->
<!-- 整体占用宽度：9                                 -->
<!-- 实际可见滑块约：5                               -->
<!--                                                 -->
<!-- 仅通过显式引用使用，                            -->
<!-- 不影响全局其他 ScrollBar。                     -->
<!-- =============================================== -->

<Style
    x:Key="TaskDescriptionThinScrollBarStyle"
    TargetType="{x:Type ScrollBar}">

    <!-- 整个可操作区域宽度 -->
    <Setter
        Property="Width"
        Value="9" />

    <Setter
        Property="MinWidth"
        Value="9" />

    <Setter
        Property="Background"
        Value="Transparent" />

    <!-- 默认稍微弱化 -->
    <Setter
        Property="Opacity"
        Value="0.62" />

    <Setter
        Property="Focusable"
        Value="False" />


    <Setter Property="Template">

        <Setter.Value>

            <ControlTemplate
                TargetType="{x:Type ScrollBar}">

                <Grid
                    Width="9"
                    Background="Transparent"
                    SnapsToDevicePixels="True">

                    <Track
                        x:Name="PART_Track"
                        Focusable="False"
                        IsDirectionReversed="True"
                        Orientation="Vertical">


                        <!-- ====================== -->
                        <!-- 滑块上方轨道           -->
                        <!-- 永远透明               -->
                        <!-- ====================== -->

                        <Track.DecreaseRepeatButton>

                            <RepeatButton
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                Command="{x:Static ScrollBar.PageUpCommand}"
                                CommandTarget="{Binding
                                    RelativeSource={RelativeSource
                                        TemplatedParent}}">

                                <RepeatButton.Template>

                                    <ControlTemplate
                                        TargetType="{x:Type RepeatButton}">

                                        <Border
                                            Background="Transparent" />

                                    </ControlTemplate>

                                </RepeatButton.Template>

                            </RepeatButton>

                        </Track.DecreaseRepeatButton>


                        <!-- ====================== -->
                        <!-- 真正的滚动滑块         -->
                        <!-- ====================== -->

                        <Track.Thumb>

                            <Thumb
                                MinHeight="32"
                                Margin="2,1"
                                Background="#C5C5C5">

                                <Thumb.Template>

                                    <ControlTemplate
                                        TargetType="{x:Type Thumb}">

                                        <Border
                                            x:Name="ThumbBody"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3" />


                                        <ControlTemplate.Triggers>


                                            <!-- 鼠标经过 -->
                                            <Trigger
                                                Property="IsMouseOver"
                                                Value="True">

                                                <Setter
                                                    TargetName="ThumbBody"
                                                    Property="Background"
                                                    Value="#A8A8A8" />

                                            </Trigger>


                                            <!-- 拖动 -->
                                            <Trigger
                                                Property="IsDragging"
                                                Value="True">

                                                <Setter
                                                    TargetName="ThumbBody"
                                                    Property="Background"
                                                    Value="#909090" />

                                            </Trigger>


                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Thumb.Template>

                            </Thumb>

                        </Track.Thumb>


                        <!-- ====================== -->
                        <!-- 滑块下方轨道           -->
                        <!-- 永远透明               -->
                        <!-- ====================== -->

                        <Track.IncreaseRepeatButton>

                            <RepeatButton
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                Command="{x:Static ScrollBar.PageDownCommand}"
                                CommandTarget="{Binding
                                    RelativeSource={RelativeSource
                                        TemplatedParent}}">

                                <RepeatButton.Template>

                                    <ControlTemplate
                                        TargetType="{x:Type RepeatButton}">

                                        <Border
                                            Background="Transparent" />

                                    </ControlTemplate>

                                </RepeatButton.Template>

                            </RepeatButton>

                        </Track.IncreaseRepeatButton>


                    </Track>

                </Grid>

            </ControlTemplate>

        </Setter.Value>

    </Setter>


    <Style.Triggers>


        <!-- 无法滚动时非常弱 -->
        <Trigger
            Property="IsEnabled"
            Value="False">

            <Setter
                Property="Opacity"
                Value="0.10" />

        </Trigger>


        <!-- 鼠标进入滚动条区域时稍微明显 -->
        <Trigger
            Property="IsMouseOver"
            Value="True">

            <Setter
                Property="Opacity"
                Value="0.90" />

        </Trigger>


    </Style.Triggers>

</Style>

    <Style
        x:Key="NavigationItemStyle"
        TargetType="ListBoxItem">

        <Setter
            Property="HorizontalContentAlignment"
            Value="Stretch" />

        <Setter
            Property="Padding"
            Value="12,10" />

        <Setter
            Property="Margin"
            Value="0,3" />

        <Setter
            Property="Cursor"
            Value="Hand" />

        <Setter
            Property="Background"
            Value="Transparent" />

        <Setter
            Property="Foreground"
            Value="{StaticResource Brush.TextPrimary}" />

        <Setter
            Property="BorderBrush"
            Value="Transparent" />

        <Setter
            Property="BorderThickness"
            Value="1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                        <Grid>
                            <Border
                                x:Name="SelectionIndicator"
                                Width="3"
                                Height="20"
                                Margin="-7,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource Brush.Primary}"
                                CornerRadius="2"
                                Opacity="0" />

                            <ContentPresenter />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>

                        <Trigger
                            Property="IsSelected"
                            Value="True">

                            <Setter
                                TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource Brush.PrimaryLight}" />

                            <Setter
                                TargetName="ItemBorder"
                                Property="BorderBrush"
                                Value="#D5E2FF" />

                            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />

                            <Setter
                                TargetName="SelectionIndicator"
                                Property="Opacity"
                                Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="CardStyle"
        TargetType="Border">

        <Setter
            Property="Background"
            Value="{StaticResource Brush.CardBackground}" />

        <Setter
            Property="BorderBrush"
            Value="{StaticResource Brush.Border}" />

        <Setter
            Property="BorderThickness"
            Value="1" />

        <Setter
            Property="CornerRadius"
            Value="16" />

        <Setter
            Property="Padding"
            Value="22" />

    </Style>

    <!-- 主界面任务详情：14px 标签正文，13px 输入与选项值。 -->
    <Style
        x:Key="TaskDetailsCardStyle"
        TargetType="Border"
        BasedOn="{StaticResource CardStyle}">
        <Setter Property="TextElement.FontSize" Value="14" />
    </Style>

    <!--
        日期分组标题中的紧凑型展开/折叠按钮。

        这个样式只负责按钮本身：
        1. 小型圆形外框；
        2. 细箭头；
        3. 展开时向上，折叠时向下；
        4. 轻微的鼠标悬停反馈。
    -->
    <Style
        x:Key="CompactDateGroupHeaderToggleStyle"
        TargetType="{x:Type ToggleButton}">

        <Setter
            Property="Background"
            Value="Transparent" />

        <Setter
            Property="BorderThickness"
            Value="0" />

        <Setter
            Property="Padding"
            Value="0" />

        <Setter
            Property="Focusable"
            Value="False" />

        <Setter
            Property="HorizontalContentAlignment"
            Value="Stretch" />

        <Setter
            Property="Foreground"
            Value="{StaticResource Brush.TextSecondary}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type ToggleButton}">

                    <Grid
                        Background="Transparent"
                        SnapsToDevicePixels="True">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--
                            小型圆形图标。

                            原来的默认图标视觉上偏大，
                            这里固定为 16 × 16。
                        -->
                        <Border
                            x:Name="IconBorder"
                            Grid.Column="0"
                            Width="14"
                            Height="14"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.SurfaceSubtle}"
                            BorderBrush="{TemplateBinding Foreground}"
                            BorderThickness="1"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">

    			<Border.RenderTransform>
        			<TranslateTransform Y="-1" />
    			</Border.RenderTransform>

                            <!-- 默认折叠状态：向下箭头 -->
                            <Path
                                x:Name="Chevron"
                                Width="6"
                                Height="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 1,1 L 4,4 L 7,1"
                                Stretch="Uniform"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeThickness="1.1"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round" />
                        </Border>

                        <!-- 原有的“已过期、今天、日期、数量”等标题内容 -->
                        <ContentPresenter
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            ContentSource="Content"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="True" />
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- 展开状态：箭头向上 -->
                        <Trigger
                            Property="IsChecked"
                            Value="True">

                            <Setter
                                TargetName="Chevron"
                                Property="Data"
                                Value="M 1,4 L 4,1 L 7,4" />
                        </Trigger>

                        <!-- 鼠标经过时使用轻微蓝色反馈 -->
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="IconBorder"
                                Property="Background"
                                Value="{StaticResource Brush.PrimaryLight}" />
                        </Trigger>

                        <!-- 按下时稍微加深 -->
                        <Trigger
                            Property="IsPressed"
                            Value="True">

                            <Setter
                                TargetName="IconBorder"
                                Property="Background"
                                Value="{StaticResource Brush.SurfaceSelected}" />
                        </Trigger>

                        <Trigger
                            Property="IsEnabled"
                            Value="False">

                            <Setter
                                Property="Opacity"
                                Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        日期分组使用的 Expander 模板。

        该模板把上面的紧凑按钮与原有分组内容连接起来。
        点击图标或整个标题区域，都可以展开和折叠。
    -->
    <Style
        x:Key="CompactDateGroupExpanderStyle"
        TargetType="{x:Type Expander}">

        <Setter
            Property="Background"
            Value="Transparent" />

        <Setter
            Property="Foreground"
            Value="{StaticResource Brush.TextSecondary}" />

        <Setter
            Property="HorizontalContentAlignment"
            Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type Expander}">

                    <Grid
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 分组标题 -->
                        <ToggleButton
                            x:Name="HeaderSite"
                            Grid.Row="0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
			    Foreground="{TemplateBinding Foreground}"
                            Focusable="False"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource CompactDateGroupHeaderToggleStyle}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                            IsChecked="{Binding
                                IsExpanded,
                                Mode=TwoWay,
                                RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- 展开后的任务内容 -->
                        <ContentPresenter
                            x:Name="ExpandSite"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            ContentSource="Content"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsExpanded"
                            Value="True">

                            <Setter
                                TargetName="ExpandSite"
                                Property="Visibility"
                                Value="Visible" />
                        </Trigger>

                        <Trigger
                            Property="IsEnabled"
                            Value="False">

                            <Setter
                                TargetName="HeaderSite"
                                Property="Opacity"
                                Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
	
	<Style.Triggers>

            <!--
                今天使用醒目的蓝色箭头；
                红色继续只代表已过期。
            -->
            <DataTrigger
                Binding="{Binding Items[0].IsTodayGroup}"
                Value="True">

                <Setter
                    Property="Foreground"
                    Value="{StaticResource Brush.TodayAccent}" />

            </DataTrigger>

            <!--
                日期分组名称为“已过期”时，
                整个折叠按钮的 Foreground 变红。
                圆框和箭头会自动跟随。
            -->
            <DataTrigger
                Binding="{Binding Name}"
                Value="已过期">

                <Setter
                    Property="Foreground"
                    Value="{StaticResource Brush.Danger}" />

                </DataTrigger>
            </Style.Triggers>
    </Style>

<!--
    桌面小组件滑动开关。

    关闭：
    蓝色圆点位于左侧，右侧显示 OFF。

    开启：
    蓝色轨道，左侧显示 ON，
    白色圆点移动到右侧。
-->
<Style
    x:Key="DesktopWidgetSwitchStyle"
    TargetType="{x:Type ToggleButton}">

    <Setter
        Property="Width"
        Value="76" />

    <Setter
        Property="Height"
        Value="32" />

    <Setter
        Property="Background"
        Value="{StaticResource Brush.SurfaceSubtle}" />

    <Setter
        Property="BorderBrush"
        Value="{StaticResource Brush.BorderStrong}" />

    <Setter
        Property="BorderThickness"
        Value="1" />

    <Setter
        Property="Foreground"
        Value="{StaticResource Brush.Primary}" />

    <Setter
        Property="Cursor"
        Value="Hand" />

    <Setter
        Property="Focusable"
        Value="True" />

    <Setter
        Property="FocusVisualStyle"
        Value="{x:Null}" />

    <Setter
        Property="IsThreeState"
        Value="False" />

    <Setter Property="Template">
        <Setter.Value>

            <ControlTemplate
                TargetType="{x:Type ToggleButton}">

                <Grid
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    SnapsToDevicePixels="True">

                    <!-- 开关轨道 -->
                    <Border
                        x:Name="SwitchTrack"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">

                        <Grid>

                            <!-- 关闭时右侧显示 OFF -->
                            <TextBlock
                                x:Name="OffText"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="OFF"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding Foreground}" />

                            <!-- 开启时左侧显示 ON -->
                            <TextBlock
                                x:Name="OnText"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="ON"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Opacity="0" />

                            <!-- 滑动圆点 -->
                            <Ellipse
                                x:Name="SwitchThumb"
                                Width="26"
                                Height="26"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{StaticResource Brush.Primary}"
                                SnapsToDevicePixels="True">

                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        ShadowDepth="1"
                                        Direction="270"
                                        Opacity="0.20" />
                                </Ellipse.Effect>

                                <Ellipse.RenderTransform>
                                    <TranslateTransform
                                        x:Name="ThumbTransform"
                                        X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                        </Grid>
                    </Border>
                </Grid>

                <ControlTemplate.Triggers>

                    <!-- 开启状态 -->
                    <Trigger
                        Property="IsChecked"
                        Value="True">

                        <Setter
                            TargetName="SwitchTrack"
                            Property="Background"
                            Value="{StaticResource Brush.Primary}" />

                        <Setter
                            TargetName="SwitchTrack"
                            Property="BorderBrush"
                            Value="{StaticResource Brush.Primary}" />

                        <Setter
                            TargetName="SwitchThumb"
                            Property="Fill"
                            Value="White" />

                        <Setter
                            TargetName="OffText"
                            Property="Opacity"
                            Value="0" />

                        <Setter
                            TargetName="OnText"
                            Property="Opacity"
                            Value="1" />

                        <!--
                            76 - 左右各3 - 圆点26 = 44
                            所以圆点向右移动44像素。
                        -->
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>

                                    <DoubleAnimation
                                        Storyboard.TargetName="ThumbTransform"
                                        Storyboard.TargetProperty="X"
                                        To="44"
                                        Duration="0:0:0.16">

                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase
                                                EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>

                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>

                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>

                                    <DoubleAnimation
                                        Storyboard.TargetName="ThumbTransform"
                                        Storyboard.TargetProperty="X"
                                        To="0"
                                        Duration="0:0:0.16">

                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase
                                                EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>

                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>

                    <!-- 鼠标经过 -->
                    <Trigger
                        Property="IsMouseOver"
                        Value="True">

                        <Setter
                            TargetName="SwitchTrack"
                            Property="BorderBrush"
                            Value="{StaticResource Brush.PrimaryHover}" />
                    </Trigger>

                    <!-- 键盘焦点 -->
                    <Trigger
                        Property="IsKeyboardFocused"
                        Value="True">

                        <Setter
                            TargetName="SwitchTrack"
                            Property="BorderBrush"
                            Value="{StaticResource Brush.PrimaryPressed}" />

                        <Setter
                            TargetName="SwitchTrack"
                            Property="BorderThickness"
                            Value="2" />
                    </Trigger>

                    <!-- 执行异步命令期间 -->
                    <Trigger
                        Property="IsEnabled"
                        Value="False">

                        <Setter
                            TargetName="SwitchTrack"
                            Property="Opacity"
                            Value="0.48" />
                    </Trigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

</ResourceDictionary>
