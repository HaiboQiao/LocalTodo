<Window
    x:Class="LocalTodo.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:LocalTodo.ViewModels"
    xmlns:views="clr-namespace:LocalTodo.Views"
    Title="LocalTodo"
    Width="1360"
    Height="860"
    MinWidth="1100"
    MinHeight="700"
    WindowStartupLocation="Manual"
    Background="{StaticResource Brush.WindowBackground}">

    <Window.Resources>

        <!-- ============================== -->
        <!-- 页面 ViewModel 对应的视图      -->
        <!-- ============================== -->

        <DataTemplate
            DataType="{x:Type viewModels:TaskListViewModel}">

            <views:TaskListView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type viewModels:MainMatrixSessionViewModel}">

            <views:MatrixView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type viewModels:CalendarViewModel}">

            <views:CalendarView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type viewModels:WeeklyPlanViewModel}">

            <views:WeeklyPlanView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type viewModels:AchievementViewModel}">

            <views:AchievementView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type viewModels:TrashViewModel}">

            <views:TrashView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type viewModels:PlaceholderPageViewModel}">

            <Border Style="{StaticResource CardStyle}">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding Title}"
                        FontSize="24"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Text="{Binding Message}"
                        Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </Border>
        </DataTemplate>


        <!-- ======================================= -->
        <!-- 桌面小组件滑动开关                     -->
        <!--                                         -->
        <!-- 按钮区域：34 × 18                      -->
        <!-- 可见轨道：28 × 16                      -->
        <!-- 圆点尺寸：12 × 12                      -->
        <!-- 滑动距离：12                           -->
        <!-- ======================================= -->

        <Style
            x:Key="DesktopWidgetSwitchStyle"
            TargetType="{x:Type ToggleButton}">

            <Setter
                Property="Width"
                Value="34" />

            <Setter
                Property="Height"
                Value="18" />

            <Setter
                Property="Padding"
                Value="0" />

            <Setter
                Property="Background"
                Value="Transparent" />

            <Setter
                Property="BorderThickness"
                Value="0" />

            <Setter
                Property="Cursor"
                Value="Hand" />

            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}" />

            <Setter
                Property="IsThreeState"
                Value="False" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type ToggleButton}">

                        <Grid
                            x:Name="SwitchRoot"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="Transparent">


                            <!-- ========================== -->
                            <!-- 开关轨道                   -->
                            <!-- ========================== -->

                            <Border
                                x:Name="SwitchTrack"
                                Width="28"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource Brush.BorderStrong}"
                                CornerRadius="10">

                                <!--
                                    28 宽轨道，
                                    左右各留 2，
                                    圆点宽 12。

                                    28 - 2 - 2 - 12 = 12

                                    所以圆点最大移动距离正好为 12。
                                -->
                                <Grid
                                    Margin="2,0">

                                    <Ellipse
                                        x:Name="SwitchThumb"
                                        Width="12"
                                        Height="12"
                                        Margin="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Fill="White">

                                        <Ellipse.Effect>

                                            <DropShadowEffect
                                                BlurRadius="2"
                                                Direction="270"
                                                ShadowDepth="1"
                                                Opacity="0.14"
                                                Color="#64748B" />

                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </Grid>


                        <!-- ============================== -->
                        <!-- 状态控制                       -->
                        <!-- ============================== -->

                        <ControlTemplate.Triggers>


                            <!-- ========================== -->
                            <!-- 开启                       -->
                            <!-- ========================== -->

                            <Trigger
                                Property="IsChecked"
                                Value="True">

                                <!-- 轨道变蓝 -->
                                <Setter
                                    TargetName="SwitchTrack"
                                    Property="Background"
                                    Value="{StaticResource Brush.Primary}" />

                                <!--
                                    最终状态固定在右侧。
                                    即使动画不播放，
                                    IsChecked=True 时圆点仍然会在右边。
                                -->
                                <Setter
                                    TargetName="SwitchThumb"
                                    Property="Margin"
                                    Value="12,0,0,0" />


                                <!-- 左 -> 右 -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation
                                                Storyboard.TargetName="SwitchThumb"
                                                Storyboard.TargetProperty="Margin"
                                                From="0,0,0,0"
                                                To="12,0,0,0"
                                                Duration="0:0:0.15"
                                                FillBehavior="Stop" />

                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>


                                <!-- 右 -> 左 -->
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation
                                                Storyboard.TargetName="SwitchThumb"
                                                Storyboard.TargetProperty="Margin"
                                                From="12,0,0,0"
                                                To="0,0,0,0"
                                                Duration="0:0:0.15"
                                                FillBehavior="Stop" />

                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>


                            <!-- 鼠标按下 -->
                            <Trigger
                                Property="IsPressed"
                                Value="True">

                                <Setter
                                    TargetName="SwitchRoot"
                                    Property="Opacity"
                                    Value="0.82" />

                            </Trigger>


                            <!-- Command 执行期间可能短暂禁用 -->
                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="SwitchRoot"
                                    Property="Opacity"
                                    Value="0.9" />

                                <Setter
                                    Property="Cursor"
                                    Value="Arrow" />

                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <!-- ============================== -->
    <!-- 主窗口布局                     -->
    <!-- ============================== -->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- ============================== -->
        <!-- 左侧导航栏                     -->
        <!-- ============================== -->

        <Border
            Grid.Column="0"
            Background="{StaticResource Brush.SidebarBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,1,0">

            <DockPanel
                Margin="18"
                LastChildFill="True">


                <!-- 程序名称 -->
                <Grid
                    DockPanel.Dock="Top"
                    Margin="6,10,6,24">

                    <StackPanel>

                        <TextBlock
                            Text="LocalTodo"
                            FontSize="22"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Margin="0,3,0,0"
                            Text="本地离线任务管理"
                            FontSize="11"
                            Foreground="{StaticResource Brush.TextMuted}" />
                    </StackPanel>
                </Grid>


                <!-- 左下角信息 -->
                <Border
                    DockPanel.Dock="Bottom"
                    Margin="2,16,2,2"
                    Padding="12"
                    Background="{StaticResource Brush.CardBackground}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="8"
                            Height="8"
                            Margin="0,3,9,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource Brush.Success}"
                            CornerRadius="4" />

                        <StackPanel Grid.Column="1">

                            <TextBlock
                                Text="便携式本地模式"
                                FontSize="12"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Margin="0,3,0,0"
                                Text="数据保存在程序文件夹中"
                                TextWrapping="Wrap"
                                FontSize="11"
                                Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>


                <!-- 导航菜单和小组件开关 -->
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- 导航菜单 -->
                    <ListBox
                        Grid.Row="0"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem}"
                        ItemContainerStyle="{StaticResource NavigationItemStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>

                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding Title}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding
                                        Foreground,
                                        RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>


                    <!-- ============================== -->
                    <!-- 设置下方的小组件开关           -->
                    <!-- ============================== -->

                    <Border
                        Grid.Row="1"
                        Margin="2,16,2,0"
                        Padding="12"
                        Background="{StaticResource Brush.CardBackground}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12">

                        <StackPanel>

                            <TextBlock
                                Text="应用设置"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Brush.TextMuted}" />

                            <!-- ============================== -->
                            <!-- 开机自启动                    -->
                            <!-- ============================== -->

                            <Grid
                                Margin="0,9,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*" />

                                    <ColumnDefinition
                                        Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="开机自启动"
                                    FontSize="12"
                                    FontWeight="Medium" />

                                <ToggleButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DesktopWidgetSwitchStyle}"
                                    IsChecked="{Binding
                                        IsStartupEnabled,
                                        Mode=OneWay}"
                                    Command="{Binding
                                        ToggleStartupCommand}"
                                    ToolTip="打开或关闭 LocalTodo 开机自启动"
                                    AutomationProperties.Name="开机自启动开关"
                                    AutomationProperties.HelpText="控制 LocalTodo 是否在 Windows 登录后自动启动" />

                            </Grid>


                            <!-- ============================== -->
                            <!-- 桌面四象限                    -->
                            <!-- ============================== -->

                            <Grid
                                Margin="0,7,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*" />

                                    <ColumnDefinition
                                        Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="桌面四象限"
                                    FontSize="12"
                                    FontWeight="Medium" />

                                <ToggleButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DesktopWidgetSwitchStyle}"
                                    IsChecked="{Binding
                                        IsMatrixWidgetEnabled,
                                        Mode=OneWay}"
                                    Command="{Binding
                                        ToggleMatrixWindowCommand}"
                                    ToolTip="打开或关闭桌面四象限"
                                    AutomationProperties.Name="桌面四象限开关"
                                    AutomationProperties.HelpText="打开或关闭桌面四象限小组件" />

                            </Grid>

                            <!-- ============================== -->
                            <!-- 桌面任务列表                  -->
                            <!-- ============================== -->

                            <Grid
                                Margin="0,7,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*" />

                                    <ColumnDefinition
                                        Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="桌面任务列表"
                                    FontSize="12"
                                    FontWeight="Medium" />

                                <ToggleButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DesktopWidgetSwitchStyle}"
                                    IsChecked="{Binding
                                        IsDesktopTaskListWidgetEnabled,
                                        Mode=OneWay}"
                                    Command="{Binding
                                        ToggleDesktopTaskListWindowCommand}"
                                    ToolTip="打开或关闭桌面任务列表"
                                    AutomationProperties.Name="桌面任务列表开关"
                                    AutomationProperties.HelpText="打开或关闭桌面任务列表小组件" />

                            </Grid>

                            <!-- ============================== -->
                            <!-- 隐藏任务列表四象限简写          -->
                            <!-- ============================== -->

                            <Grid
                                Margin="0,7,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="*" />

                                    <ColumnDefinition
                                        Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="隐藏四象限图标"
                                    FontSize="12"
                                    FontWeight="Medium" />

                                <ToggleButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DesktopWidgetSwitchStyle}"
                                    IsChecked="{Binding
                                        IsTaskListQuadrantAbbreviationHidden,
                                        Mode=OneWay}"
                                    Command="{Binding
                                        ToggleTaskListQuadrantAbbreviationCommand}"
                                    ToolTip="隐藏或显示任务列表中的四象限简写"
                                    AutomationProperties.Name="隐藏四象限图标开关"
                                    AutomationProperties.HelpText="隐藏或显示所有任务、已完成和垃圾箱中的四象限简写" />

                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>


        <!-- ============================== -->
        <!-- 右侧页面内容                   -->
        <!-- ============================== -->

        <Grid
            Grid.Column="1"
            Margin="28,26,30,28">

            <!--
                不再显示页面级大标题和页面描述。

                所有任务、日历、四象限、已完成、垃圾箱
                的实际页面内容直接占满右侧内容区域。
            -->
            <ContentControl
                Content="{Binding CurrentPageViewModel}" />

        </Grid>
    </Grid>
</Window>
