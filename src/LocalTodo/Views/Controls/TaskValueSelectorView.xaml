<UserControl
    x:Class="LocalTodo.Views.Controls.TaskValueSelectorView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False">

    <StackPanel>
        <TextBlock
            Margin="0,0,0,6"
            Text="{Binding Label, ElementName=Root}"
            FontSize="14"
            FontWeight="SemiBold" />

        <ComboBox
            Height="38"
            FontSize="13"
            Padding="8,4"
            VerticalContentAlignment="Center"
            ItemsSource="{Binding ItemsSource, ElementName=Root}"
            DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
            SelectedValuePath="{Binding SelectedValuePath, ElementName=Root}"
            SelectedValue="{Binding SelectedValue,
                ElementName=Root,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
