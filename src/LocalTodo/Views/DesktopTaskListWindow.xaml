<Window
    x:Class="LocalTodo.Views.DesktopTaskListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:LocalTodo.Views"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="LocalTodo 桌面任务列表"
    Width="520"
    Height="720"
    MinWidth="360"
    MinHeight="360"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="False"
    Background="{StaticResource Brush.WindowBackground}">

    <shell:WindowChrome.WindowChrome>

        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="8"
            UseAeroCaptionButtons="False" />

    </shell:WindowChrome.WindowChrome>

    <Grid
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- 与主窗口一致的轻量自定义标题栏。 -->
        <Border
            Grid.Row="0"
            Background="{StaticResource Brush.CardBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1,1,1,0"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        Text="LocalTodo"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        FontSize="15"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Margin="10,0,0,0"
                        Text="桌面任务列表"
                        Foreground="{StaticResource Brush.TextMuted}"
                        FontSize="13" />

                </StackPanel>

                <Button
                    Grid.Column="1"
                    Focusable="False"
                    Background="Transparent"
                    Foreground="{StaticResource Brush.TextSecondary}"
                    BorderThickness="0"
                    FontSize="18"
                    Cursor="Hand"
                    Content="×"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click" />

            </Grid>

        </Border>


        <!-- 主体 -->
        <Border
            Grid.Row="1"
            Background="{StaticResource Brush.WindowBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="0,0,8,8"
            SnapsToDevicePixels="True">

            <views:DesktopTaskListView
                x:Name="DesktopTaskListViewControl"
                Margin="14" />

        </Border>

    </Grid>

</Window>
