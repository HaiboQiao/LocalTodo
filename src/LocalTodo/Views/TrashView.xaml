<UserControl
    x:Class="LocalTodo.Views.TrashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />

        <Style
            x:Key="TrashTaskItemStyle"
            TargetType="ListBoxItem">

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="Padding"
                Value="0" />

            <Setter
                Property="Margin"
                Value="0" />

            <Setter
                Property="Background"
                Value="Transparent" />

            <Setter
                Property="BorderThickness"
                Value="0" />

            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}">

                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>

                            <Trigger
                                Property="IsSelected"
                                Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource Brush.SurfaceSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            页面级操作状态。

            正常情况下折叠；
            只在读取、恢复、永久删除或发生错误时显示。
        -->
        <TextBlock
            Grid.Row="0"
            Margin="2,0,0,14"
            Text="{Binding StatusMessage}"
            Foreground="{StaticResource Brush.TextSecondary}"
            Visibility="{Binding HasStatusMessage,
                Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：垃圾箱任务列表 -->
            <Border
                Grid.Column="0"
                Padding="18"
                Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="66" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        ==========================================
                        左侧标题区
                        与“所有任务 / 已完成”任务列表标题完全一致
                        ==========================================
                    -->
                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,12">

                        <Grid.RowDefinitions>

                            <!-- 任务列表标题 -->
                            <RowDefinition Height="Auto" />

                            <!-- 任务数量 -->
                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 任务列表标题 -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="任务列表"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Brush.TextPrimary}" />

                        <!-- 垃圾箱任务数量 -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,6,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding TaskCountText}"
                            FontSize="12"
                            Foreground="{StaticResource Brush.TextSecondary}" />

                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox
                            ItemsSource="{Binding Tasks}"
                            SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                            ItemContainerStyle="{StaticResource TrashTaskItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Visible">

                            <ListBox.Resources>

                                <!-- ======================================= -->
                                <!-- 垃圾箱任务列表专用细纵向滚动条        -->
                                <!-- 与“所有任务”任务列表保持一致          -->
                                <!-- ======================================= -->

                                <Style
                                    TargetType="{x:Type ScrollBar}">

                                    <!-- 整个可操作区域宽度 -->
                                    <Setter
                                        Property="Width"
                                        Value="10" />

                                    <Setter
                                        Property="Background"
                                        Value="Transparent" />

                                    <Setter
                                        Property="Focusable"
                                        Value="False" />

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate
                                                TargetType="{x:Type ScrollBar}">

                                                <Grid
                                                    Width="{TemplateBinding Width}"
                                                    Background="Transparent">

                                                    <Track
                                                        x:Name="PART_Track"
                                                        Orientation="Vertical"
                                                        IsDirectionReversed="True"
                                                        Minimum="{TemplateBinding Minimum}"
                                                        Maximum="{TemplateBinding Maximum}"
                                                        ViewportSize="{TemplateBinding ViewportSize}"
                                                        Value="{Binding
                                                            Value,
                                                            RelativeSource={RelativeSource
                                                                TemplatedParent},
                                                            Mode=TwoWay}">

                                                        <!-- 上方轨道 -->
                                                        <Track.DecreaseRepeatButton>

                                                            <RepeatButton
                                                                Command="{x:Static
                                                                    ScrollBar.PageUpCommand}"
                                                                Focusable="False"
                                                                Background="Transparent"
                                                                BorderThickness="0">

                                                                <RepeatButton.Template>

                                                                    <ControlTemplate
                                                                        TargetType="{x:Type RepeatButton}">

                                                                        <Border
                                                                            Background="Transparent" />

                                                                    </ControlTemplate>

                                                                </RepeatButton.Template>

                                                            </RepeatButton>

                                                        </Track.DecreaseRepeatButton>

                                                        <!-- 真正可见的灰色滑块 -->
                                                        <Track.Thumb>

                                                            <Thumb
                                                                MinHeight="30"
                                                                Background="#CBD3DD">

                                                                <Thumb.Template>

                                                                    <ControlTemplate
                                                                        TargetType="{x:Type Thumb}">

                                                                        <Grid
                                                                            Background="Transparent">

                                                                            <Border
                                                                                Width="6"
                                                                                Margin="0,2"
                                                                                HorizontalAlignment="Center"
                                                                                Background="#CBD3DD"
                                                                                CornerRadius="3" />

                                                                        </Grid>

                                                                    </ControlTemplate>

                                                                </Thumb.Template>

                                                            </Thumb>

                                                        </Track.Thumb>

                                                        <!-- 下方轨道 -->
                                                        <Track.IncreaseRepeatButton>

                                                            <RepeatButton
                                                                Command="{x:Static
                                                                    ScrollBar.PageDownCommand}"
                                                                Focusable="False"
                                                                Background="Transparent"
                                                                BorderThickness="0">

                                                                <RepeatButton.Template>

                                                                    <ControlTemplate
                                                                        TargetType="{x:Type RepeatButton}">

                                                                        <Border
                                                                            Background="Transparent" />

                                                                    </ControlTemplate>

                                                                </RepeatButton.Template>

                                                            </RepeatButton>

                                                        </Track.IncreaseRepeatButton>

                                                    </Track>

                                                </Grid>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </ListBox.Resources>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="8,12"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,0,0,1">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Column="0"
                                                Orientation="Horizontal">

                                                <ContentPresenter
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource TaskListStatusMarkerTemplate}" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    FontWeight="Medium" />
                                            </StackPanel>

                                            <!-- 四象限简写 -->
                                            <TextBlock
                                                Grid.Column="1"
                                                MinWidth="58"
                                                Margin="0,0,14,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding QuadrantListText}"
                                                TextAlignment="Right"
                                                FontSize="11"
                                                Foreground="{StaticResource Brush.TextSecondary}"
                                                Visibility="{Binding
                                                    DataContext.ShowQuadrantAbbreviations,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <!-- 截止日期 -->
                                            <TextBlock
                                                Grid.Column="2"
                                                MinWidth="78"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding DueDateText}"
                                                TextAlignment="Right"
                                                TextWrapping="NoWrap"
                                                FontSize="11"
                                                Foreground="{StaticResource Brush.TextSecondary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="垃圾箱中没有任务"
                                FontSize="18"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Text="删除的任务会显示在这里。"
                                Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右侧：只读任务详情 -->
            <Border
                Grid.Column="2"
                Padding="18"
                Style="{StaticResource TaskDetailsCardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="66" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        ==========================================
                        右侧标题区
                        与“所有任务 / 已完成”任务详情标题完全一致
                        ==========================================
                    -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        Orientation="Vertical">

                        <!-- 任务详情标题 -->
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="任务详情"
                            Style="{StaticResource TaskDetailsHeadingTextStyle}" />

                        <!-- 垃圾箱固定只读提示 -->
                        <TextBlock
                            Margin="0,6,0,0"
                            Text="垃圾箱中的任务仅支持查看，不能直接修改。"
                            FontSize="13"
                            Foreground="{StaticResource Brush.TextSecondary}"
                            TextTrimming="CharacterEllipsis" />

                    </StackPanel>

                    <Grid Grid.Row="1">

                        <!--
                            =========================================
                            选中任务后的只读详情
                            =========================================

                            这里故意不再使用外层 ScrollViewer。

                            整个垃圾箱任务详情始终完整显示；
                            主窗口高度变化时，只让中间的任务说明框
                            吸收剩余高度。

                            底部三行信息始终保持可见并贴近详情底部。
                            只有任务说明文字本身显示不下时，
                            任务说明 TextBox 内部才出现细滚动条。
                        -->
                        <Grid
                            Margin="0,0,6,0"
                            Visibility="{Binding HasSelectedTask,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Grid.RowDefinitions>

                                <!-- 顶部固定：标题、重点、标题框、任务说明标题 -->
                                <RowDefinition Height="Auto" />

                                <!-- 中间动态：唯一随窗口高度变化的任务说明区域 -->
                                <RowDefinition Height="*" />

                                <!-- 底部固定：垃圾箱三行只读信息和操作 -->
                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>

                            <!-- ===================================== -->
                            <!-- 第 0 行：顶部固定内容                 -->
                            <!-- ===================================== -->
                            <StackPanel Grid.Row="0">

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="任务标题"
                                        FontWeight="SemiBold" />

                                    <CheckBox
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Style="{StaticResource ImportantTaskCheckBoxStyle}"
                                        Content="标记为重要任务"
                                        IsChecked="{Binding SelectedTask.IsImportant, Mode=OneWay}"
                                        IsEnabled="False" />
                                </Grid>

                                <TextBox
                                    Height="40"
                                    Style="{StaticResource TaskDetailsTextBoxStyle}"
                                    Padding="10,6"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding SelectedTask.Title, Mode=OneWay}"
                                    IsReadOnly="True" />

                                <TextBlock
                                    Margin="0,18,0,6"
                                    Text="任务说明"
                                    FontWeight="SemiBold" />

                            </StackPanel>

                            <!-- ===================================== -->
                            <!-- 第 1 行：响应式任务说明区域           -->
                            <!--                                       -->
                            <!-- 这一行是 *，因此主窗口高度变化时，    -->
                            <!-- 只会改变这个 TextBox 的高度。         -->
                            <!-- ===================================== -->
                            <TextBox
                                Grid.Row="1"
                                Style="{StaticResource TaskDetailsTextBoxStyle}"
                                MinHeight="100"
                                Padding="10"
                                VerticalAlignment="Stretch"
                                Text="{Binding SelectedTask.Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">

                                <TextBox.Resources>

                                    <!--
                                        只修改任务说明 TextBox 内部滚动条。
                                        内容能够完整显示时不会出现；
                                        内容过长时才显示细滚动条。
                                    -->
                                    <Style
                                        TargetType="{x:Type ScrollBar}"
                                        BasedOn="{StaticResource
                                            TaskDescriptionThinScrollBarStyle}" />

                                </TextBox.Resources>

                            </TextBox>

                            <!--
                                ==========================================
                                第 2 行：垃圾箱任务详情 3 行统一信息区
                                ==========================================

                                第一行：
                                截止日期 / 截止时间 / 是否提醒

                                第二行：
                                所属象限 / 是否循环 / 永久删除

                                第三行：
                                删除前状态 / 删除时间 / 恢复任务

                                这一整块使用 Auto 高度，
                                因此始终位于右侧详情的底部。
                            -->
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,18,0,0">

                                <!-- ================================= -->
                                <!-- 第一行：日期 / 时间 / 提醒        -->
                                <!-- ================================= -->

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 截止日期 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Text="截止日期"
                                            FontWeight="SemiBold" />

                                        <TextBox
                                            Height="38"
                                            Style="{StaticResource TaskDetailsTextBoxStyle}"
                                            Padding="10,6"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding SelectedDueDateText, Mode=OneWay}"
                                            IsReadOnly="True"
                                            IsTabStop="False" />
                                    </StackPanel>

                                    <!-- 截止时间 -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Text="截止时间"
                                            FontWeight="SemiBold" />

                                        <TextBox
                                            Height="38"
                                            Style="{StaticResource TaskDetailsTextBoxStyle}"
                                            Padding="10,6"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding SelectedDueTimeText, Mode=OneWay}"
                                            IsReadOnly="True"
                                            IsTabStop="False" />
                                    </StackPanel>

                                    <!-- 是否提醒 -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Text="是否提醒"
                                            FontWeight="SemiBold" />

                                        <TextBox
                                            Height="38"
                                            Style="{StaticResource TaskDetailsTextBoxStyle}"
                                            Padding="10,6"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding SelectedReminderText, Mode=OneWay}"
                                            IsReadOnly="True"
                                            IsTabStop="False" />
                                    </StackPanel>
                                </Grid>


                                <!-- ================================= -->
                                <!-- 第二行：象限 / 循环 / 永久删除    -->
                                <!-- ================================= -->

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 所属象限 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Text="所属象限"
                                            FontWeight="SemiBold" />

                                        <TextBox
                                            Height="38"
                                            Style="{StaticResource TaskDetailsTextBoxStyle}"
                                            Padding="10,6"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding SelectedQuadrantText, Mode=OneWay}"
                                            IsReadOnly="True"
                                            IsTabStop="False" />
                                    </StackPanel>

                                    <!-- 是否循环 -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Text="是否循环"
                                            FontWeight="SemiBold" />

                                        <TextBox
                                            Height="38"
                                            Style="{StaticResource TaskDetailsTextBoxStyle}"
                                            Padding="10,6"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding SelectedRepeatText, Mode=OneWay}"
                                            IsReadOnly="True"
                                            IsTabStop="False" />
                                    </StackPanel>

                                    <!-- 永久删除 -->
                                    <StackPanel Grid.Column="4">
                                        <!--
                                            空标题用于占位，
                                            让按钮和前两个只读字段底边对齐。
                                        -->
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Text=" "
                                            FontWeight="SemiBold" />

                                        <Button
                                            Height="38"
                                            Style="{StaticResource TaskDangerActionButtonStyle}"
                                            Content="永久删除"
                                            Command="{Binding PermanentlyDeleteTaskCommand}"
                                            CommandParameter="{Binding SelectedTask}" />
                                    </StackPanel>
                                </Grid>


                                <!-- ================================= -->
                                <!-- 第三行：状态 / 删除时间 / 恢复    -->
                                <!-- ================================= -->

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        标题和实际内容拆成两个 Grid.Row。
                                        第二行统一固定为 38 高，
                                        保证状态、时间和恢复按钮严格水平居中。
                                    -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="38" />
                                    </Grid.RowDefinitions>

                                    <!-- 标题 -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,6"
                                        Text="删除前状态"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,0,6"
                                        Text="删除时间"
                                        FontWeight="SemiBold" />

                                    <!-- 删除前状态 -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding SelectedDeletedStatusText}"
                                        Foreground="{StaticResource Brush.TextSecondary}" />

                                    <!-- 删除时间 -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{Binding SelectedDeletedAtText}"
                                        Foreground="{StaticResource Brush.TextSecondary}" />

                                    <!-- 恢复任务 -->
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="4"
                                        Height="38"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Brush.SurfaceSubtle}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Content="恢复任务"
                                        Command="{Binding RestoreTaskCommand}"
                                        CommandParameter="{Binding SelectedTask}" />
                                </Grid>

                            </StackPanel>
                        </Grid>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasSelectedTask}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="请选择一条任务"
                                FontSize="20"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Text="选择后可以恢复任务或永久删除。"
                                Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
