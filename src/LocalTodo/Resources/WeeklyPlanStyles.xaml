<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:LocalTodo.Models">

    <!-- 每周计划专用的低饱和浅色主题，不进入全局视觉资源。 -->
    <SolidColorBrush x:Key="WeeklyPlan.Blue.Background" Color="#EAF2FF" />
    <SolidColorBrush x:Key="WeeklyPlan.Blue.Accent" Color="#5479B8" />
    <SolidColorBrush x:Key="WeeklyPlan.Green.Background" Color="#ECF7EF" />
    <SolidColorBrush x:Key="WeeklyPlan.Green.Accent" Color="#4F8C65" />
    <SolidColorBrush x:Key="WeeklyPlan.Teal.Background" Color="#E8F7F5" />
    <SolidColorBrush x:Key="WeeklyPlan.Teal.Accent" Color="#3F8783" />
    <SolidColorBrush x:Key="WeeklyPlan.Purple.Background" Color="#F2EDFA" />
    <SolidColorBrush x:Key="WeeklyPlan.Purple.Accent" Color="#7864A8" />
    <SolidColorBrush x:Key="WeeklyPlan.Pink.Background" Color="#FBEFF3" />
    <SolidColorBrush x:Key="WeeklyPlan.Pink.Accent" Color="#A8647E" />
    <SolidColorBrush x:Key="WeeklyPlan.Orange.Background" Color="#FFF1E7" />
    <SolidColorBrush x:Key="WeeklyPlan.Orange.Accent" Color="#B87645" />
    <SolidColorBrush x:Key="WeeklyPlan.Yellow.Background" Color="#FFF8DF" />
    <SolidColorBrush x:Key="WeeklyPlan.Yellow.Accent" Color="#9A8238" />
    <SolidColorBrush x:Key="WeeklyPlan.Gray.Background" Color="#F1F3F6" />
    <SolidColorBrush x:Key="WeeklyPlan.Gray.Accent" Color="#6F7887" />
    <SolidColorBrush x:Key="WeeklyPlan.Grid.Hour" Color="#E7EBF1" />
    <SolidColorBrush x:Key="WeeklyPlan.Grid.HalfHour" Color="#F2F4F7" />
    <SolidColorBrush x:Key="WeeklyPlan.Grid.DayDivider" Color="#E9EDF2" />
    <SolidColorBrush x:Key="WeeklyPlan.Header.Background" Color="#F3F6FA" />
    <SolidColorBrush x:Key="WeeklyPlan.Header.Foreground" Color="#26364D" />
    <SolidColorBrush x:Key="WeeklyPlan.Header.Secondary" Color="#506078" />

    <Style
        x:Key="WeeklyPlanCardBorderStyle"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WeeklyPlan.Blue.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Blue.Accent}" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Green}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Green.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Green.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Teal}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Teal.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Teal.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Purple}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Purple.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Purple.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Pink}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Pink.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Pink.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Orange}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Orange.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Orange.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Yellow}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Yellow.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Yellow.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Gray}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Gray.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Gray.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="WeeklyPlanAccentTextStyle"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Blue.Accent}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Green}">
                <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Green.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Teal}">
                <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Teal.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Purple}">
                <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Purple.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Pink}">
                <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Pink.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Orange}">
                <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Orange.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Yellow}">
                <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Yellow.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Item.Color}" Value="{x:Static models:WeeklyPlanColor.Gray}">
                <Setter Property="Foreground" Value="{StaticResource WeeklyPlan.Gray.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="WeeklyPlanColorDotStyle"
        TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource WeeklyPlan.Blue.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Blue.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:WeeklyPlanColor.Green}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Green.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Green.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:WeeklyPlanColor.Teal}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Teal.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Teal.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:WeeklyPlanColor.Purple}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Purple.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Purple.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:WeeklyPlanColor.Pink}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Pink.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Pink.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:WeeklyPlanColor.Orange}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Orange.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Orange.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:WeeklyPlanColor.Yellow}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Yellow.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Yellow.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static models:WeeklyPlanColor.Gray}">
                <Setter Property="Background" Value="{StaticResource WeeklyPlan.Gray.Background}" />
                <Setter Property="BorderBrush" Value="{StaticResource WeeklyPlan.Gray.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="WeeklyPlanColorItemStyle"
        TargetType="ListBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="18">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
