<UserControl
    x:Class="LocalTodo.Views.WeeklyPlanView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:LocalTodo.Models"
    Focusable="True"
    Background="Transparent"
    Loaded="OnViewLoaded"
    Unloaded="OnViewUnloaded"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewMouseLeftButtonDown="OnViewPreviewMouseLeftButtonDown"
    PreviewMouseMove="OnPreviewMouseMove"
    PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
    LostMouseCapture="OnLostMouseCapture">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/LocalTodo;component/Resources/WeeklyPlanStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 每周计划内的提示统一使用轻量浅色浮层，避免系统深色提示破坏整体视觉。 -->
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Placement" Value="Mouse" />
                <Setter Property="HorizontalOffset" Value="12" />
                <Setter Property="VerticalOffset" Value="10" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border
                                MaxWidth="330"
                                Padding="12,10"
                                Background="#FFFFFF"
                                BorderBrush="#DCE3ED"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border
            Padding="0"
            ClipToBounds="True"
            Style="{StaticResource CardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="{StaticResource WeeklyPlan.Header.Background}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,1,1">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="时间"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource WeeklyPlan.Header.Secondary}" />
                </Border>

                <ItemsControl
                    Grid.Row="0"
                    Grid.Column="1"
                    ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{StaticResource WeeklyPlan.Header.Background}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="0,0,1,1">
                                <Grid Margin="7,0">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Title}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WeeklyPlan.Header.Foreground}" />
                                    <Button
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource Brush.Primary}"
                                        FontSize="16"
                                        FontWeight="Normal"
                                        ToolTip="在这一天新增计划"
                                        Command="{Binding DataContext.StartCreateForDayCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding Day}"
                                        Content="+" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource Brush.CardBackground}"
                    ClipToBounds="True">
                    <ItemsControl
                        ItemsSource="{Binding GridLines}"
                        IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Top" Value="{Binding LabelTop}" />
                                <Setter Property="Canvas.Left" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Width="50"
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Right"
                                    Text="{Binding Title}"
                                    TextAlignment="Right"
                                    FontSize="10"
                                    Foreground="{StaticResource Brush.TextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHour}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Grid
                    x:Name="WeekSurface"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="{StaticResource Brush.CardBackground}"
                    ClipToBounds="True"
                    SizeChanged="OnTimelineSizeChanged"
                    PreviewMouseLeftButtonDown="OnTimelineMouseLeftButtonDown">

                    <ItemsControl
                        ItemsSource="{Binding Days}"
                        IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="Transparent"
                                    BorderBrush="{StaticResource WeeklyPlan.Grid.DayDivider}"
                                    BorderThickness="0,0,1,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl
                        ItemsSource="{Binding GridLines}"
                        IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                <Setter Property="Canvas.Left" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Height="1"
                                    Width="{Binding ActualWidth,
                                        ElementName=WeekSurface}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource WeeklyPlan.Grid.HalfHour}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHour}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WeeklyPlan.Grid.Hour}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="双击或拖动空白区域创建计划"
                        FontSize="13"
                        Foreground="{StaticResource Brush.TextMuted}"
                        IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPlans}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Canvas
                        x:Name="WeekCanvas"
                        Background="Transparent">
                        <ItemsControl
                            x:Name="PlanCardsItemsControl"
                            Width="{Binding ActualWidth, ElementName=WeekSurface}"
                            Height="{Binding ActualHeight, ElementName=WeekSurface}"
                            ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    <Setter Property="Width" Value="{Binding Width}" />
                                    <Setter Property="Height" Value="{Binding Height}" />
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        ClipToBounds="True">

                                        <Grid.ToolTip>
                                            <ToolTip
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                ToolTipService.ShowDuration="12000">
                                                <StackPanel>
                                                    <TextBlock
                                                        Text="{Binding Item.Title}"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1F2A3D"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,6,0,0"
                                                        Text="拖动主体：移动计划&#x0a;Ctrl + 拖动主体：复制计划&#x0a;拖动上下边缘：调整时间&#x0a;单击选中后按 Delete：删除计划&#x0a;双击：编辑计划"
                                                        FontSize="12"
                                                        LineHeight="20"
                                                        Foreground="#5D6A7F" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Grid.ToolTip>

                                        <Border
                                            Margin="1"
                                            Padding="6,3"
                                            Cursor="SizeAll"
                                            Style="{StaticResource WeeklyPlanCardBorderStyle}"
                                            MouseLeftButtonDown="OnPlanBlockMouseLeftButtonDown">
                                            <Grid>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Text="{Binding Item.StartTimeText}"
                                                        FontSize="10"
                                                        Style="{StaticResource WeeklyPlanAccentTextStyle}" />
                                                    <TextBlock
                                                        Margin="0,10"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Item.Title}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource Brush.TextPrimary}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Text="{Binding Item.EndTimeText}"
                                                        FontSize="10"
                                                        Style="{StaticResource WeeklyPlanAccentTextStyle}" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Item.StartTimeText}"
                                                        FontSize="10"
                                                        Style="{StaticResource WeeklyPlanAccentTextStyle}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Item.Title}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource Brush.TextPrimary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Item.EndTimeText}"
                                                        FontSize="10"
                                                        Style="{StaticResource WeeklyPlanAccentTextStyle}" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Rectangle
                                            Height="4"
                                            Margin="3,0"
                                            VerticalAlignment="Top"
                                            Fill="Transparent"
                                            Cursor="SizeNS"
                                            ToolTip="拖动上边缘调整开始时间"
                                            MouseLeftButtonDown="OnPlanStartHandleMouseLeftButtonDown" />

                                        <Rectangle
                                            Height="4"
                                            Margin="3,0"
                                            VerticalAlignment="Bottom"
                                            Fill="Transparent"
                                            Cursor="SizeNS"
                                            ToolTip="拖动下边缘调整结束时间"
                                            MouseLeftButtonDown="OnPlanEndHandleMouseLeftButtonDown" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            Ctrl 拖动使用独立预览层：原计划始终留在原位，
                            副本实时跟随鼠标，但只有有效落点才会在松手后持久化。
                        -->
                        <Grid
                            x:Name="CopyPreviewHost"
                            Visibility="Collapsed"
                            Panel.ZIndex="18"
                            ClipToBounds="False"
                            IsHitTestVisible="False">
                            <ContentControl
                                Content="{Binding}"
                                ContentTemplate="{Binding ItemTemplate, ElementName=PlanCardsItemsControl}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Opacity" Value="0.9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlacementValid}" Value="False">
                                                <Setter Property="Opacity" Value="0.56" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <Border
                                Margin="0"
                                Background="Transparent"
                                BorderThickness="2"
                                CornerRadius="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#2E9D69" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlacementValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="#D14343" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Border
                                Width="18"
                                Height="18"
                                Margin="0,-7,-7,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                CornerRadius="9">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2E9D69" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlacementValid}" Value="False">
                                                <Setter Property="Background" Value="#D14343" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="+" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlacementValid}" Value="False">
                                                    <Setter Property="Text" Value="×" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <Border
                            x:Name="CreationPreview"
                            Visibility="Collapsed"
                            Panel.ZIndex="20"
                            Background="{StaticResource WeeklyPlan.Blue.Background}"
                            BorderBrush="{StaticResource WeeklyPlan.Blue.Accent}"
                            BorderThickness="1"
                            CornerRadius="0"
                            IsHitTestVisible="False">
                            <Grid Margin="6,2">
                                <TextBlock
                                    x:Name="CreationPreviewStartText"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="10"
                                    Foreground="{StaticResource WeeklyPlan.Blue.Accent}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="新计划"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock
                                    x:Name="CreationPreviewEndText"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    FontSize="10"
                                    Foreground="{StaticResource WeeklyPlan.Blue.Accent}" />
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <Border
            MaxWidth="360"
            Margin="0,56,8,0"
            Padding="10,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="20"
            Background="{StaticResource Brush.CardBackground}"
            BorderBrush="{StaticResource Brush.Danger}"
            BorderThickness="1"
            CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis"
                Foreground="{StaticResource Brush.Danger}" />
        </Border>

        <Grid
            Panel.ZIndex="30">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border
                Background="#520F172A"
                MouseLeftButtonDown="OnEditorBackdropMouseLeftButtonDown" />

            <Border
                Width="540"
                MaxHeight="740"
                Margin="24"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource PopupCardStyle}"
                IsVisibleChanged="OnEditorVisibilityChanged">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding EditorHeading}"
                                Style="{StaticResource TaskPopupHeadingTextStyle}" />
                            <Button
                                Grid.Column="1"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding CancelEditCommand}"
                                Content="×"
                                FontSize="18"
                                Foreground="{StaticResource Brush.TextSecondary}" />
                        </Grid>

                        <TextBlock Margin="0,16,0,6" Text="计划名称" FontSize="14" FontWeight="SemiBold" />
                        <TextBox
                            x:Name="EditorTitleTextBox"
                            Height="40"
                            MaxLength="120"
                            Style="{StaticResource TaskEditorTextBoxStyle}"
                            Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,6" Text="计划说明" FontSize="14" FontWeight="SemiBold" />
                        <TextBox
                            Height="82"
                            MaxLength="1000"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Style="{StaticResource TaskEditorTextBoxStyle}"
                            Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,6" Text="星期" FontSize="14" FontWeight="SemiBold" />
                                <ComboBox
                                    Height="38"
                                    FontSize="13"
                                    ItemsSource="{Binding DayOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding EditorDay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" Text="开始时间" FontSize="14" FontWeight="SemiBold" />
                                <ComboBox
                                    Height="38"
                                    FontSize="13"
                                    ItemsSource="{Binding StartTimeOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Minutes"
                                    SelectedValue="{Binding EditorStartMinutes}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,6" Text="结束时间" FontSize="14" FontWeight="SemiBold" />
                                <ComboBox
                                    Height="38"
                                    FontSize="13"
                                    ItemsSource="{Binding EndTimeOptions}"
                                    DisplayMemberPath="Title"
                                    SelectedValuePath="Minutes"
                                    SelectedValue="{Binding EditorEndMinutes}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,7" Text="显示颜色" FontSize="14" FontWeight="SemiBold" />
                        <ListBox
                            ItemsSource="{Binding ColorOptions}"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding EditorColor}"
                            ItemContainerStyle="{StaticResource WeeklyPlanColorItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Style="{StaticResource WeeklyPlanColorDotStyle}"
                                        ToolTip="{Binding Title}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Margin="0,12,0,0"
                            Text="{Binding EditorErrorMessage}"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource Brush.Danger}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEditorError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                MinWidth="96"
                                Height="40"
                                Command="{Binding DeleteCommand}"
                                Content="删除计划">
                                <Button.Style>
                                    <Style
                                        TargetType="Button"
                                        BasedOn="{StaticResource TaskDangerActionButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditingExisting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button
                                Grid.Column="2"
                                MinWidth="84"
                                Height="40"
                                Command="{Binding CancelEditCommand}"
                                Content="取消" />

                            <Button
                                Grid.Column="4"
                                MinWidth="108"
                                Height="40"
                                Style="{StaticResource TaskPrimaryActionButtonStyle}"
                                Command="{Binding SaveCommand}"
                                Content="保存计划" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
