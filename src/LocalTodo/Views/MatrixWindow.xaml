<Window
    x:Class="LocalTodo.Views.MatrixWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:LocalTodo.Views"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="LocalTodo 桌面四象限"
    Width="1040"
    Height="720"
    MinWidth="820"
    MinHeight="560"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="False"
    Background="{StaticResource Brush.WindowBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
        CaptionHeight="0"
        ResizeBorderThickness="6"
        GlassFrameThickness="0"
        CornerRadius="8"
        UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 与主窗口一致的轻量自定义标题栏。 -->
        <Border
            Grid.Row="0"
            Background="{StaticResource Brush.CardBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1,1,1,0"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        Text="LocalTodo"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        FontSize="15"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Margin="10,0,0,0"
                        Text="桌面四象限"
                        Foreground="{StaticResource Brush.TextMuted}"
                        FontSize="13" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Focusable="False"
                    Background="Transparent"
                    Foreground="{StaticResource Brush.TextSecondary}"
                    BorderThickness="0"
                    FontSize="18"
                    Cursor="Hand"
                    Content="×"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click" />
            </Grid>
        </Border>

        <!--
            四象限内容区域。

            左右和底部边框只作用于内容区域，
            与上方轻量标题栏保持清晰分层。

            CornerRadius 只处理左下角和右下角。
        -->
        <Border
            Grid.Row="1"
            Background="{StaticResource Brush.WindowBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="0,0,8,8"
            SnapsToDevicePixels="True">

            <views:MatrixView Margin="16" />
        </Border>
    </Grid>
</Window>
